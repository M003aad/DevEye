{
  "manifest_version": 3,
  "name": "DevEye",
  "version": "1.0.0",
  "description": "A lightweight CSS inspector for developers and designers.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_title": "DevEye Inspector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/16.png",
      "32": "assets/32.png",
      "48": "assets/48.png",
      "128": "assets/128.png"
    }
  },
  "icons": {
    "16": "assets/16.png",
    "32": "assets/32.png",
    "48": "assets/48.png",
    "128": "assets/128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "overlay.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
